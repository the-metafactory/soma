{
  "name": "soma",
  "version": "0.29.0",
  "private": true,
  "type": "module",
  "description": "Substrate-portable Personal AI Assistant core.",
  "scripts": {
    "dashboard": "bun scripts/mission-dashboard.ts",
    "lint": "eslint . --ignore-pattern \"integrations/**\"",
    "lint:fix": "eslint . --ignore-pattern \"integrations/**\" --fix",
    "soma": "bun src/cli.ts",
    "harness-eval": "bun scripts/harness-eval.ts",
    "knowledge-eval": "bun scripts/knowledge-eval.ts",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "check:literal-sets": "bun scripts/check-literal-sets.ts",
    "check:suppressions": "bun scripts/check-suppressions.ts",
    "test": "bun test --timeout=60000 --parallel=6",
    "test:portability": "bun test test/portability-ci.test.ts",
    "check-skill-version": "bun scripts/check-skill-version.ts",
    "check-release-privacy": "bun scripts/check-release-privacy.ts",
    "measure-graph-read-path": "bun scripts/measure-graph-read-path.ts",
    "generate-bundled-skill-files": "bun scripts/generate-bundled-skill-files.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "eslint": "^10.3.0",
    "typescript-eslint": "^8.59.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@the-metafactory/myelin": "https://github.com/the-metafactory/myelin.git#v0.11.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
